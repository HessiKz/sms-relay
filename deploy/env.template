# Template for /etc/sms-relay/env  (mode 0640, owner root:smsrelay)
#
# The service reads this file via systemd EnvironmentFile and via the
# --env-file argument of `python -m app.main`. Every key below is
# REQUIRED except the optional ones marked as such. Do not commit a
# filled-in copy of this file.

# --- Telegram -------------------------------------------------------------
# Bot token of the Telegram bot that delivers the SMS.
TELEGRAM_BOT_TOKEN=

# Numeric chat id that receives the messages. In a private chat with a
# bot, the chat id equals the user id of the account you talk to.
TELEGRAM_CHAT_ID=

# Numeric Telegram user id allowed to run remote commands (/pause, ...).
ADMIN_TELEGRAM_USER_ID=

# --- API authentication ----------------------------------------------------
# Strong random strings. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The device token is given to the Android phone; the admin token is for
# the administrative API. They must differ.
PHONE_A_TOKEN=
ADMIN_TOKEN=

# --- Storage and network ---------------------------------------------------
# SQLite database on persistent local storage (never /tmp).
DATABASE_PATH=/var/lib/sms-relay/sms.db

# Bind address. Keep it on loopback: Caddy is the only public entry point.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8090

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Telegram Mini App (optional) ------------------------------------------
# Public URL of the Mini App. When set, the bot gains an "Open inbox"
# button and each relayed SMS gains an "Open chat" button. Must be https.
# MINIAPP_URL=https://ai-barrow.ir/relay/app/
# Bot username without @, only for t.me/<bot>?startapp=... links.
# MINIAPP_BOT_USERNAME=
# initData lifetime and server-side send caps.
# MINIAPP_AUTH_MAX_AGE=86400
# MINIAPP_SEND_PER_MINUTE=6
# MINIAPP_SEND_DAILY_CAP=50
