<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS permissions are HARD RESTRICTED on Android 10+: a sideloaded
         app cannot receive them unless the user makes it the default SMS
         app (RoleManager.ROLE_SMS) or the Play installer allowlists
         them. The app therefore asks for the role in MainActivity. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />

    <!-- The default-SMS-app role also requires the MMS/WAP-push
         permissions and a WAP_PUSH_DELIVER receiver, even though this
         relay only forwards SMS. Without them Android and several OEMs
         do not list the app as a messaging app. -->
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <!-- Needed to list the active SIMs (dual SIM). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Calls: the call log and the dialpad, and - once the app holds
         ROLE_DIALER - the incoming call itself. The log is a runtime
         permission group of its own; the phone asks for it in the
         "Calls" card of the setup screen. CALL_PHONE and
         ANSWER_PHONE_CALLS are also what Android checks before it
         grants the dialer role. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- The in-call notification. The screen is the primary path; this
         notification is the fallback when the platform refuses to start
         the activity (a locked work profile, a vendor background-start
         block), so the call must still be answerable. Without the
         permission Android 13+ drops it silently, which would leave the
         call reachable only from the server. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A ringing call wants to take over the screen. Android 14 turns
         this into a user-granted permission; a default dialer is allowed
         by default, and the service checks the answer before it uses it
         and keeps the notification buttons either way. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The contact list is uploaded so the bot can show contact names
         instead of numbers. The user grants this at runtime. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Opening the per-app "ignore battery optimisations" dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (API 30+): without this the Xiaomi autostart
         screen cannot be resolved. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.samsung.android.lool" />
        <!-- Needed on Android 11+ so the default SMS package can be
             resolved (Telephony.Sms.getDefaultSmsPackage). -->
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
        <!-- Package visibility (API 30+): without these, the "call via"
             row of the dialpad cannot see whether WhatsApp, Viber, Skype,
             FaceTime or a browser is installed, and would hide every
             entry on a modern phone. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viber" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="skype" />
        </intent>
        <!-- Telegram is reached through its own scheme: `https://t.me/+…`
             is an invite-link shape, not a phone lookup, so the app must
             be visible for `tg://resolve?phone=…` instead. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="facetime" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".RelayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsRelay">

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- The home of the app: the Messages list of the phone's own SMS
             store. It is the launcher, and it is the one place the setup
             screen, the dialpad and the thread screen are reached from.
             Material 3 and no action bar: the screen draws its own
             toolbar, so `Theme.SmsRelay` (and with it the setup screen)
             does not change. -->
        <activity
            android:name=".ui.ShellActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmsRelay.Messages">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One conversation, with a composer for one to one SMS. It is
             reached from the list and from the contact picker, never from
             outside the app, so it stays unexported. `adjustResize` lets
             the composer ride above the keyboard. -->
        <activity
            android:name=".ui.ThreadActivity"
            android:exported="false"
            android:label="@string/messages_title"
            android:parentActivityName=".ui.ShellActivity"
            android:theme="@style/Theme.SmsRelay.Messages"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history"
            android:parentActivityName=".ui.MainActivity" />

        <!-- The Phone home: Favorites, Recents, Contacts, Voicemail, with
             the dialpad one tap away.

             It is reached from the Messages home's menu and from its own
             FAB, never from another app, and it never handles `tel:` or
             `ACTION_DIAL`: that stays on the dialpad below, which is the
             one screen that knows how to route an emergency call. So this
             activity is unexported and has no intent filter, and it keeps
             the Material 3 theme of the Messages screens so the two homes
             look like one app. -->
        <activity
            android:name=".ui.DialerHomeActivity"
            android:exported="false"
            android:label="@string/dialer_title"
            android:parentActivityName=".ui.ShellActivity"
            android:theme="@style/Theme.SmsRelay.Messages" />

        <!-- The dialpad and the handler of tel: links.

             It keeps its ACTION_DIAL and tel: filters, because the
             default-dialer role needs them, but it is no longer the
             launcher: the Messages home is. The Phone home reaches this
             screen from its FAB and its menu, and every call log row and
             contact opens it with `tel:` in the field. The setup screen
             is reached from the menus of both homes. -->
        <activity
            android:name=".calls.DialerActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- The in-call UI. Full-screen over the lock screen, because a
             ringing call is exactly the moment the user needs it.
             singleTask keeps one instance: a second call must not stack
             a second window. The theme has no action bar: this is a call,
             not a screen of the app. -->
        <activity
            android:name=".calls.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:theme="@style/Theme.SmsRelay.Call"
            android:turnScreenOn="true" />

        <!-- The InCallService of a default dialer. Android only binds it
             while this app holds ROLE_DIALER; the metadata tells the
             platform that this app draws the in-call UI and its own
             ringing screen, which is what makes the role picker offer it. -->
        <service
            android:name=".calls.CallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Required by the default-SMS-app role: handles sms:/smsto:/
             mms:/mmsto: "send to" intents. -->
        <activity
            android:name=".ui.ComposeSmsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Required by the default-SMS-app role: quick reply service. -->
        <service
            android:name=".ui.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </service>

        <!-- Incoming SMS.
             SMS_DELIVER is only sent to the default SMS app, which is
             exactly what this app asks the user to become; SMS_RECEIVED
             is kept for older releases and for devices without a default
             SMS app. The priority only influences the order of delivery:
             the broadcast is not abortable, so the inbox copy is not
             stolen from the user's real SMS app. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Required by the default-SMS-app role. The relay does not
             implement MMS; this receiver exists so Android and OEM role
             pickers recognise the app as a messaging app. MMS pushes are
             acknowledged and ignored. -->
        <receiver
            android:name=".receiver.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Delivery reports for fallback SMS sent from the app's SIM. -->
        <receiver
            android:name=".sms.SendStatusReceiver"
            android:exported="false" />

        <!-- Delivery reports for the SMS commands that arrive from
             Telegram: the radio answer corrects a failed command. -->
        <receiver
            android:name=".sms.CommandSendStatusReceiver"
            android:exported="false" />

        <!-- Second capture path: reads the messaging app's notification
             when the app is NOT the default SMS app. The user grants
             "notification access" in the system settings. -->
        <service
            android:name=".sms.SmsNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Re-schedules the upload worker after a reboot. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
