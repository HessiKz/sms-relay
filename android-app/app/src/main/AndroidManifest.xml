<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS permissions are HARD RESTRICTED on Android 10+: a sideloaded
         app cannot receive them unless the user makes it the default SMS
         app (RoleManager.ROLE_SMS) or the Play installer allowlists
         them. The app therefore asks for the role in MainActivity. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />

    <!-- Needed to list the active SIMs (dual SIM). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- The contact list is uploaded so the bot can show contact names
         instead of numbers. The user grants this at runtime. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Opening the per-app "ignore battery optimisations" dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (API 30+): without this the Xiaomi autostart
         screen cannot be resolved. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.samsung.android.lool" />
        <!-- Needed on Android 11+ so the default SMS package can be
             resolved (Telephony.Sms.getDefaultSmsPackage). -->
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".RelayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsRelay">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Required by the default-SMS-app role: handles sms:/smsto:/
             mms:/mmsto: "send to" intents. -->
        <activity
            android:name=".ui.ComposeSmsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Required by the default-SMS-app role: quick reply service. -->
        <service
            android:name=".ui.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </service>

        <!-- Incoming SMS.
             SMS_DELIVER is only sent to the default SMS app, which is
             exactly what this app asks the user to become; SMS_RECEIVED
             is kept for older releases and for devices without a default
             SMS app. The priority only influences the order of delivery:
             the broadcast is not abortable, so the inbox copy is not
             stolen from the user's real SMS app. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Delivery reports for fallback SMS sent from the app's SIM. -->
        <receiver
            android:name=".sms.SendStatusReceiver"
            android:exported="false" />

        <!-- Delivery reports for the SMS commands that arrive from
             Telegram: the radio answer corrects a failed command. -->
        <receiver
            android:name=".sms.CommandSendStatusReceiver"
            android:exported="false" />

        <!-- Second capture path: reads the messaging app's notification
             when the app is NOT the default SMS app. The user grants
             "notification access" in the system settings. -->
        <service
            android:name=".sms.SmsNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Re-schedules the upload worker after a reboot. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
