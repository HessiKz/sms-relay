<?xml version="1.0" encoding="utf-8"?>
<!-- A day separator: "Today", "Yesterday", or a date. One per calendar
     day that has at least one message, in the same pill style the
     messaging app uses, so it reads as a label and not as content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textDayHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:backgroundTint="?attr/colorSurfaceVariant"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
