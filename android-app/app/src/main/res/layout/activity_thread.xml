<?xml version="1.0" encoding="utf-8"?>
<!-- The thread screen.

     A plain vertical layout: toolbar, the optional role note, the
     "Load older" button, the list (which takes the rest of the height),
     the optional MMS note and the composer at the bottom. Nothing
     overlaps, so no padding has to guess the height of anything else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootThread"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarThread"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/thread_back"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="?attr/colorOnSurface">

        <!-- Avatar, name and the call action. They sit inside the
             toolbar so the platform title style does not fight the
             initials circle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textThreadAvatar"
                android:layout_width="@dimen/thread_avatar_size"
                android:layout_height="@dimen/thread_avatar_size"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/textThreadTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="A contact" />

            <ImageButton
                android:id="@+id/buttonThreadCall"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/thread_call"
                android:padding="12dp"
                android:src="@drawable/ic_call" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- The role note, when this app is not the default SMS app. -->
    <LinearLayout
        android:id="@+id/layoutThreadBanners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <!-- Only visible when the store still holds messages older than the
         page on screen. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonLoadOlder"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/thread_load_older"
        android:visibility="gone" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/textThreadState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressThread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Says that part of this conversation is MMS, which this screen
         cannot draw. Only visible when the provider's snippet is not the
         newest SMS on screen. -->
    <TextView
        android:id="@+id/textThreadNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- The composer.
         A one to one SMS is written here and sent over the SIM; the row
         is then read back from the provider like any other message. A
         group or an MMS only conversation gets a disabled bar with an
         honest reason instead of a button that would fail. -->
    <LinearLayout
        android:id="@+id/layoutComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <EditText
                    android:id="@+id/inputComposer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center_vertical|start"
                    android:hint="@string/composer_hint"
                    android:imeOptions="actionNone|flagNoExtractUi"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="6"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:scrollHorizontally="false"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageButton
                    android:id="@+id/buttonSend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/composer_send"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_send"
                    android:tint="?attr/colorOnPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressSend"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="?attr/colorOnPrimary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Shown instead of the buttons when this conversation cannot be
         written to: a group, an MMS only thread, or a store that refused
         to be read. It is the same bar height so the list does not jump. -->
    <TextView
        android:id="@+id/textComposerNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>
