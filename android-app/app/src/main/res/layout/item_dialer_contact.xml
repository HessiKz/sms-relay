<?xml version="1.0" encoding="utf-8"?>
<!-- One contact row (Contacts tab and Favorites tab).

     Two lines: the name and the number, with the avatar on the left. The
     star is a small glyph at the end of the name line - it is a marker,
     not a button, so tapping the row still dials. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/dialer_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="@dimen/dialer_avatar_size"
        android:layout_height="@dimen/dialer_avatar_size"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/textContactAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textContactName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/imageContactStar"
                android:layout_width="@dimen/dialer_type_icon_size"
                android:layout_height="@dimen/dialer_type_icon_size"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/dialer_favorite_marker"
                android:src="@drawable/ic_star"
                android:tint="?attr/colorPrimary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/textContactNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
